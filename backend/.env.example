# Example Environment Configuration
# DO NOT ADD REAL SECRETS HERE. This file is committed to version control.

# Polygon Amoy Testnet Private Key for deploying and interacting with smart contracts
POLYGON_AMOY_PRIVATE_KEY=your_private_key_here

# (Optional) RPC URL if you are using a custom provider like Alchemy or Infura
# RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
JWT_SECRET=your_jwt_secret_here
